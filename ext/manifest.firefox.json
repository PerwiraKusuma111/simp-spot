{
  "manifest_version": 2,
  "name": "Spotify Mobile Mode",
  "version": "1.6.3",
  "description": "Ubah tampilan Spotify Web Desktop jadi mirip aplikasi Spotify Mobile lengkap dengan slider lagu, Now Playing fullscreen, navigasi bawah, cari, koleksi, lirik, dan antrean",
  "browser_specific_settings": {
    "gecko": {
      "id": "simp-spot@perwirakusuma111.github.io",
      "strict_min_version": "126.0"
    },
    "gecko_android": {
      "strict_min_version": "126.0"
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "webRequest",
    "webRequestBlocking",
    "https://open.spotify.com/*",
    "https://*.spotify.com/*"
  ],
  "background": {
    "scripts": ["bg.js"]
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Spotify Mobile Mode",
    "default_icon": {
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://open.spotify.com/*"],
      "css": ["style.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
